# ==========================================
config.json
.env
*.token
*.key
token.txt

# ==========================================
# Python 运行缓存与虚拟环境
# ==========================================
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
env/
venv/
ENV/
build/
dist/
*.egg-info/

# ==========================================
# 临时媒体文件与工作区缓存（零残留保障）
# ==========================================
*.log
logs/
temp/
*.tmp
*.mp4
*.ts
*.m3u8
*.aria2

# ==========================================
# 操作系统与 IDE 配置
